# ============================================================
#  Self-Improving Agentic RAG — Environment Configuration
# ============================================================
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  Never commit .env to version control.
# ============================================================

# ── LLM Provider (Groq) ──────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Embeddings & Reranker ─────────────────────────────────────
# Models are auto-downloaded on first run from HuggingFace Hub
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking Strategy ─────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Retrieval Settings ────────────────────────────────────────
TOP_K_RETRIEVAL=10
TOP_K_RERANK=3
CONVERSATION_HISTORY_LIMIT=5

# ── Vector Database ───────────────────────────────────────────
# Options: "chroma" (default) | "qdrant" (pure-Python fallback)
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./vector_db
CHROMA_COLLECTION=rag_documents

# ── Self-Improvement Storage ──────────────────────────────────
FEEDBACK_DB_PATH=./vector_db/feedback.json

# ── API Configuration ─────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# CORS: comma-separated list of allowed origins.
# In production, replace * with your actual frontend URL.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Observability (Optional) ──────────────────────────────────
# LangSmith tracing — get a key at https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=self-improving-agentic-rag
